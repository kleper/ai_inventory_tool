# ==============================================
# SmartInventory Environment Template
# Copy this file to .env and fill in the values
# ==============================================

# 1. Database
# ----------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=smartinventory
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@db:5432/smartinventory

# 2. Backend
# ----------------------------------------------
SECRET_KEY=change_me_in_prod_openssl_rand_base64_32
OPENAI_API_KEY=sk-your-openai-key-here
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin_password_change_me

# 3. Frontend
# ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_prod_openssl_rand_base64_32
