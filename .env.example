# ==============================================
# SmartInventory Global Environment Configuration
# ==============================================

# ----------------------------------------------
# 1. Database Configuration (Shared)
# ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartinventory
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Connection String (Constructed)
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartinventory

# ----------------------------------------------
# 2. Backend API Configuration (FastAPI)
# ----------------------------------------------
# Secret key for JWT encoding/decoding (change in production)
SECRET_KEY=change_me_in_production_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me

# LLM Configuration
# ---------------------
# Provider Selection: OPENAI (Default) or GEMINI
LLM_PROVIDER=OPENAI

# Option A: OpenAI / OpenRouter
LLM_API_KEY=sk-or-your-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://openrouter.ai/api/v1

# Option B: Google Gemini
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=
# LLM_MODEL=gemini-1.5-flash

# Email (SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
DOMAIN=http://localhost:3000

# ----------------------------------------------
# 3. Frontend Configuration (Next.js)
# ----------------------------------------------
FRONTEND_PORT=3000
INTERAL_BACKEND_URL=http://backend:8000

# URL of the Backend API (browser-accessible)
NEXT_PUBLIC_API_URL=/api/proxy
INTERNAL_API_URL=http://backend:8000

# NextAuth.js Configuration
# URL of the Frontend (where the app runs)
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt session tokens (openssl rand -base64 32)
NEXTAUTH_SECRET= # Generate with: openssl rand -base64 32

# Google OAuth Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
