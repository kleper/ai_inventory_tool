# ==============================================
# SmartInventory Environment Template
# Copy this file to .env and fill in the values
# ==============================================

# 1. Database
# ----------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=smartinventory
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@db:5432/smartinventory

# 2. Backend
# ----------------------------------------------
SECRET_KEY=change_me_in_prod_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OPENAI_API_KEY=sk-your-openai-key-here
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin_password_change_me

# LLM (OpenAI / OpenRouter)
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
# For OpenRouter: https://openrouter.ai/api/v1

# Email (SMTP)
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@smartinventory.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
DOMAIN=http://localhost:3000

# 3. Frontend
# ----------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_in_prod_openssl_rand_base64_32
INTERAL_BACKEND_URL=http://backend:8000
